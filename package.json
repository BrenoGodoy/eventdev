{
  "name": "eventdev",
  "version": "1.0.0",
  "description": "EventDev é uma plataforma completa de gerenciamento de eventos e venda de ingressos desenvolvida como solução para o Desafio Elite Dev 2026 da Verzel.",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build": "npm run build:api && npm run build:web",
    "lint": "npm run lint --workspace=api && npm run lint --workspace=web",
    "test": "npm test --workspace=api -- --runInBand --no-watchman",
    "test:e2e": "npm run test:e2e --workspace=api -- --runInBand --no-watchman",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=api",
    "prisma:generate": "npm run prisma:generate --workspace=api"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrenoGodoy/eventdev.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/BrenoGodoy/eventdev/issues"
  },
  "homepage": "https://github.com/BrenoGodoy/eventdev#readme"
}
